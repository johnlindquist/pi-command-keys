  },
  "files": ["index.ts", "keys.ts", "README.md", "LICENSE"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2",
    "@earendil-works/pi-tui": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "bun-types": "^1.4.4",
    "typescript": "^5.6.0"
  },
  "scripts": {
